# Wayze Backend Configuration

# App
APP_NAME="Wayze Backend"
APP_VERSION="0.1.0"

# Database
DATABASE_URL="sqlite:///wayze.db"

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Payload Limits
MAX_MAP_SIZE_BYTES=10485760
MAX_QR_SIZE_BYTES=2048
